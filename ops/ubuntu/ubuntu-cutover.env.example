# KÖL self-hosted Ubuntu — configuration checklist, NOT runnable production settings.
# Copy to private server configuration only AFTER backup/restore + full E2E PASS.
# This file deliberately contains NO passwords, tokens, database URL or signing keys.
# Do not commit actual .env files or expose PostgreSQL publicly.
KOL_PROJECT_NAME=kol-platform
KOL_DEPLOYMENT_ENV=preview
KOL_PRODUCTION_RUNTIME_READY=false
DATA_SOURCE_MODE=mock
ALCOHOL_MODULE_ENABLED=false

# Ubuntu host and HTTPS proxy must be reviewed independently.
# KOL_PUBLIC_SITE_ORIGIN=https://YOUR-KOL-SITE-DOMAIN
# KOL_API_PUBLIC_ORIGIN=https://YOUR-KOL-API-DOMAIN
# KOL_INTERNAL_POSTGRES_PORT=5432  # internal Docker network ONLY
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-KOL-API-DOMAIN
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<provisioned-public-key>
# Secrets are injected from the host secret manager / chmod 600 file, NEVER Git.
# Required secrets: PostgreSQL credentials, Auth/JWT signing material,
# service-role keys, SMTP credentials, and backup encryption key.
# Database restore target must have PostgreSQL major 17 and compatible
# pg_stat_statements, pgcrypto, plpgsql, supabase_vault, uuid-ossp extensions.
# Do NOT set DATA_SOURCE_MODE=supabase before independent restored-data proof.
# Do NOT set KOL_PRODUCTION_RUNTIME_READY=true before verified production gate.
