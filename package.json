{
  "name": "kol-travel-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:supabase-env": "node scripts/check-supabase-env.mjs",
    "check:supabase-schema-files": "node scripts/check-supabase-schema-files.mjs",
    "check:staging-package": "node scripts/check-staging-package.mjs",
    "check:live-baseline-readonly": "node scripts/check-live-baseline-readonly.mjs",
    "check:catalog-media-bucket": "node scripts/provision-catalog-media-bucket.mjs",
    "provision:catalog-media-bucket": "node scripts/provision-catalog-media-bucket.mjs --apply",
    "check:deployment-env": "node scripts/check-deployment-env.mjs",
    "check:deployment-env:selftest": "node scripts/check-deployment-env-selftest.mjs",
    "check:release-source": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=high && npm run check:supabase-schema-files && npm run check:staging-package && npm run check:live-baseline-readonly && npm run check:deployment-env && npm run check:deployment-env:selftest && npm run lint && npx --no-install tsc --noEmit --incremental false && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
