# KÖL environment contract — example only, never commit real secret values.

# Local/recovery default. Preview may use mock until a dedicated staging Supabase is ready.
DATA_SOURCE_MODE=mock
KOL_DEPLOYMENT_ENV=development
ALCOHOL_MODULE_ENABLED=false

# Supabase public configuration. Required when DATA_SOURCE_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback while legacy projects still use anon key naming.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Do NOT prefix with NEXT_PUBLIC_.
# Add only to server environments that actually need privileged workflows.
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations remain disabled/unconfigured until their dedicated gates pass.
# N8N_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_...=
