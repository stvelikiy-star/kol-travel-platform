# KÖL environment contract — example only. Never commit real secret values.

# Local/recovery default. Preview may use mock only for intentional UI/source smoke.
DATA_SOURCE_MODE=mock
KOL_DEPLOYMENT_ENV=development
ALCOHOL_MODULE_ENABLED=false

# Production must remain fail-closed until the reviewed Supabase migration/RPC
# package, role auth and production data adapters have passed the release audit.
# Set to true only as an explicit production release action.
KOL_PRODUCTION_RUNTIME_READY=false

# Public Supabase configuration. Required when DATA_SOURCE_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback for legacy public-key naming.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=

# Server-only privileged key. NEVER expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations remain unconfigured until their own approval/test gates pass.
# N8N_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_...=
